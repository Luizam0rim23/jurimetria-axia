# Endereço público do aplicativo (sem barra no final). Deve usar HTTPS em produção.
BASE_URL=https://treino.seudominio.com.br
PORT=3000

# Credenciais do aplicativo criado em https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Senha de acesso à página (obrigatória). Use uma senha forte.
APP_PASSWORD=

# Opcional: chave para assinar a sessão. Se vazia, é gerada e salva em DATA_DIR.
SESSION_SECRET=

# Opcional: habilita /cron/sync para agendadores externos (hospedagens que hibernam).
CRON_SECRET=

# Opcional: habilita o recebimento de sono, FC de repouso e VFC do celular (Health Connect / app HC Webhook).
# Gere com: openssl rand -hex 32
HEALTH_WEBHOOK_TOKEN=

# Defina 1 quando o aplicativo estiver atrás de proxy reverso (Nginx, Caddy, Render, Railway).
TRUST_PROXY=1

# Diretório de dados (tokens, atividades, configurações). Precisa ser persistente.
DATA_DIR=./data
